# Copy to .env for development. Names starting EXPO_PUBLIC_ are read by the app and are baked into the build.
# A value left empty is the same as not set: the default below it applies.

# Where the Restora API runs. Empty in development: the app uses the computer that runs `expo start` (port 5001), which a
# phone on the same Wi-Fi can reach. Release builds use https://restora.live when it is empty. Dev site: https://dev.restora.live
EXPO_PUBLIC_API_URL=

# The web app, opened from More and used for links in emails (reset password). Empty: the same computer (port 3000).
# Production: https://app.restora.live
EXPO_PUBLIC_WEB_URL=

# The public site, where a table's QR code leads. Empty: https://restora.live
EXPO_PUBLIC_SITE_URL=

# Google sign-in (Google Cloud Console, Credentials). Both empty hides the button. Needs a development or store build,
# not Expo Go. The Web application client's ID (the server's GOOGLE_CLIENT_ID), and the iOS client's (bundle com.restoralive.app).
# Android also needs an Android client for com.restoralive.app with each signing key's SHA-1; nothing from it goes here.
# Example shape: 1234-abc.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Push alerts (build time only; the app works without them, just with no alerts).
# EAS_PROJECT_ID: the Expo project's id (`eas init` writes it into app.json, or set it here).
EAS_PROJECT_ID=
# GOOGLE_SERVICES_JSON: path to Firebase's google-services.json (Android alerts), for example ./google-services.json
GOOGLE_SERVICES_JSON=

# Not read from this file. The Play Store release (GitHub Actions, Settings, Secrets and variables, Actions):
#   Variables: EXPO_PUBLIC_API_URL (default https://restora.live), EAS_PROJECT_ID
#   Secrets:   GOOGLE_SERVICE_ACCOUNT_JSON, ANDROID_KEYSTORE_BASE64, KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD,
#              GOOGLE_SERVICES_JSON (the file's whole content)
