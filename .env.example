# Where the Restora API runs. Leave it unset in development: the app then uses the computer that runs `expo start`
# (port 5001), which a phone on the same Wi-Fi can reach. Set it for builds that talk to a real server.
# EXPO_PUBLIC_API_URL=https://api.restora.example

# The web app, opened from More and used for links in emails (reset password). Same rule (port 3000).
# EXPO_PUBLIC_WEB_URL=https://app.restora.example

# The public site, where a table's QR code leads. Defaults to https://restora.live.
# EXPO_PUBLIC_SITE_URL=https://restora.example

# Google sign-in (Google Cloud Console, Credentials). Leave unset to hide the button. Needs a development or store build,
# not Expo Go. The Web application client's ID (the server's GOOGLE_CLIENT_ID), and the iOS client's (bundle com.restora.app).
# Android also needs an Android client for com.restora.app with each signing key's SHA-1; nothing from it goes here.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1234-abc.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=1234-def.apps.googleusercontent.com
