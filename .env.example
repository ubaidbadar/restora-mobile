# Restora Mobile: local development and GitHub Android APK build configuration.
#
# REQUIRED LOCAL .env VALUES: none. Leave optional entries empty to use defaults.
# EXPO_PUBLIC_* variables are bundled into the app; do not use them for secrets.
# Expo Project ID is already in app.json (expo.extra.eas.projectId) for push
# notifications. No EAS_PROJECT_ID environment variable is needed.
#
# REQUIRED GITHUB ACTIONS SETTINGS FOR THE ANDROID APK:
#   None. The APK is built locally on a GitHub Linux runner with Gradle.
#   EAS Build, EXPO_TOKEN, and Apple credentials are NOT used.
#
# OPTIONAL GITHUB ACTIONS SETTINGS FOR ANDROID APK:
#   Variables: EXPO_PUBLIC_API_URL, EXPO_PUBLIC_WEB_URL
#   Secret: GOOGLE_SERVICES_JSON (full contents of Firebase google-services.json)
#   Secrets (all four, or none) for stable signed APKs:
#      ANDROID_KEYSTORE_BASE64, KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD.
#   Without the signing secrets, an installable APK uses a temporary debug key,
#   so it may not update older installs signed with another key.
#
# SEPARATE PLAY STORE WORKFLOW on stage/main (not used by the APK workflow):
#   REQUIRED secrets: GOOGLE_SERVICE_ACCOUNT_JSON, ANDROID_KEYSTORE_BASE64,
#      KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD.
#   OPTIONAL: GOOGLE_SERVICES_JSON secret; EXPO_PUBLIC_API_URL variable.
#
# APP-SIDE OPTIONAL SETTINGS:

# API server. Local dev defaults to Metro machine at port 5001.
# Release builds default to https://restora.live.
EXPO_PUBLIC_API_URL=

# The "Open Restora on the web" link and related web flows.
# Set this when making release builds; GitHub APK defaults to
# https://app.restora.live.
EXPO_PUBLIC_WEB_URL=

# Public site opened by QR codes. Default: https://restora.live.
EXPO_PUBLIC_SITE_URL=

# Native Google sign-in: empty disables the button. These are OAuth client IDs,
# not OAuth secrets. Android also needs a Google client with signing SHA-1.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Android push alerts only: path to local Firebase google-services.json.
# GitHub APK uses GOOGLE_SERVICES_JSON secret CONTENT instead.
# Backend needs appropriate FCM credentials configured for Expo push delivery.
GOOGLE_SERVICES_JSON=

# BACKEND ONLY. These are not copied into the mobile repo:
#   EXPO_ACCESS_TOKEN - backend authentication to the Expo Push API
#   WEB_PUSH_PUBLIC_KEY / WEB_PUSH_PRIVATE_KEY - browser notifications (VAPID)
# The Expo project ID in app.json is still used for native Expo push tokens.
#
# iOS builds are intentionally disabled in GitHub Actions for now.
