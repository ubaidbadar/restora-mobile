{
  "expo": {
    "name": "Restora",
    "slug": "restora",
    "version": "1.0.0",
    "scheme": "restora",
    "orientation": "default",
    "icon": "./assets/brand/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "com.restoralive.app",
      "supportsTablet": true,
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true
      }
    },
    "android": {
      "package": "com.restoralive.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive_foreground.png",
        "monochromeImage": "./assets/brand/adaptive_monochrome.png",
        "backgroundColor": "#4F46E5"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash.png",
          "imageWidth": 120,
          "backgroundColor": "#F6F7F9",
          "dark": {
            "backgroundColor": "#0B0F19"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/adaptive_monochrome.png",
          "color": "#4F46E5",
          "defaultChannel": "guests"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Restora uses the camera to scan the QR code on a table.",
          "recordAudioAndroid": false
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Restora uses your photos to pick your restaurant's logo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/InstrumentSans-Regular.ttf",
            "./assets/fonts/InstrumentSans-Medium.ttf",
            "./assets/fonts/InstrumentSans-SemiBold.ttf",
            "./assets/fonts/InstrumentSans-Bold.ttf",
            "./assets/fonts/BricolageGrotesque-SemiBold.ttf",
            "./assets/fonts/BricolageGrotesque-Bold.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}